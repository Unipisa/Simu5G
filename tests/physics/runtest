#! /bin/sh
#
# usage: runtest [<testfile>...]
# without args, runs all *.test files in the current directory
#
# Requires SIMU5G_ROOT and INET_ROOT to be set (source the setenv scripts of
# both projects first), and the Simu5G and INET shared libraries to be built.
#

MODE=${MODE:-release}
if [ "$MODE" = "debug" ]; then D="_dbg"; else D=""; fi

TESTFILES=$*
if [ "x$TESTFILES" = "x" ]; then TESTFILES='*.test'; fi

if [ "x$SIMU5G_ROOT" = "x" ]; then echo "Error: SIMU5G_ROOT is not set"; exit 1; fi
if [ "x$INET_ROOT" = "x" ]; then echo "Error: INET_ROOT is not set"; exit 1; fi

if [ ! -d work ]; then mkdir work; fi

# Drop generated directories whose .test file is gone. opp_test only ever adds
# to work/, so after a branch switch it otherwise still holds the generated
# output of tests that no longer exist here -- which a grader would happily
# read as if it belonged to this run.
for d in work/*/; do
    [ -d "$d" ] || continue     # no match: the glob is left unexpanded
    name=`basename "$d"`
    if [ ! -f "$name.test" ]; then echo "removing stale $d"; rm -rf "$d"; fi
done

# Unlike tests/unit, a physics test contributes no C++ of its own: it runs a
# real simulation of the shipped model and grades the results. There is
# therefore nothing to compile, but opp_test insists on an executable in the
# working directory, so put one there -- opp_run with libsimu5g loaded.
cat > work/physicstests$D <<EOF
#! /bin/sh
exec opp_run$D -l "$SIMU5G_ROOT/src/simu5g" \\
     -n ".:$SIMU5G_ROOT/simulations:$SIMU5G_ROOT/src:$INET_ROOT/src" "\$@"
EOF
chmod +x work/physicstests$D

opp_test gen $OPT -v $TESTFILES || exit 1
echo

opp_test run $OPT -v -p physicstests$D $TESTFILES || exit 1
echo
echo Results can be found in ./work
