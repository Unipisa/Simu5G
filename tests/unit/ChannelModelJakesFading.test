%description:

StochasticChannelModel::jakesFading() and rayleighFading(): what the small-scale
fading value is, when it is drawn, and -- the part most exposed to a
refactoring -- whose state it is drawn into.

The value is graded exactly. On the first call for a link the model draws a
realization band by band, and within each band path by path: an angle of
arrival, cos(uniform(0, pi)), and a delay spread, exponential(delayRms), stored
as a simtime_t. It then sums the paths, one-ring (Clarke) with Cavers'
frequency selectivity, at the transmission's start time t with a Doppler shift of
speed * f / c.
An RngSnapshot taken before the call replays the same draws, so the test
recomputes that sum independently and compares -- to 1e-9 dB, since both sides
evaluate the same operations in the same order.

A link has one realization, kept once per link by the radio medium and used by
whichever end evaluates it: a DL CQI computed at the base station describes
exactly the channel the UE then decodes through, and the uplink of the same pair
of nodes is faded by the same paths. A background UE has no radio on the medium,
but its link to the base station is a link like any other: its DL and UL CQIs
fade by one realization.

rayleighFading() is pinned as a set of tripwires, because what it does is
surprising and ought to fail loudly if it changes: it is a lookup in the one
table PhyPisaData shares across the whole simulation, indexed by band alone,
so every node on a band gets the same value, the value never changes over time,
and no random number is drawn. That every link on a band shares one value is a
defect -- fading belongs to a link -- and is labelled PINNED DEFECT;
ChannelModelRayleighFading asserts independent links as an expected failure.

%includes:
#include "SchedulerTestUtil.h"
#include "ChannelModelTestUtil.h"

%global:
using namespace simu5g;
using namespace simu5g::unittest;
using omnetpp::SimTime;

// The control information a packet from 'source' to 'dest' carries, with the
// sender's position.
static UserControlInfo controlInfo(Direction dir, LtePhyFrameType type, MacNodeId source,
        MacNodeId dest, const inet::Coord& senderPosition)
{
    UserControlInfo info;
    info.setDirection(dir);
    info.setFrameType(type);
    info.setSourceId(source);
    info.setDestId(dest);
    info.setCoord(senderPosition);
    return info;
}

// A realization, as jakesFading() draws it: [band][path].
struct JakesRealization
{
    std::vector<std::vector<double>> cosAoa;
    std::vector<std::vector<double>> delay;  // seconds, quantized as a simtime_t is
};

// The draws of a realization, replayed from a snapshot of the model's RNG.
static JakesRealization replayRealization(omnetpp::cRNG *rng, int bands, int paths, double delayRms)
{
    JakesRealization r;
    r.cosAoa.resize(bands);
    r.delay.resize(bands);
    for (int b = 0; b < bands; b++)
        for (int p = 0; p < paths; p++) {
            r.cosAoa[b].push_back(cos(omnetpp::uniform(rng, 0, M_PI)));
            r.delay[b].push_back(SimTime(omnetpp::exponential(rng, delayRms)).dbl());
        }
    return r;
}

// |H|^2 in dB for one band of a realization, written out from the model's
// documented formula. The speed of light is spelled out rather than taken from
// the macro the model uses, so that a change to that constant fails here.
static double jakesGainDb(const JakesRealization& r, int band, double speed, double fHz, double startTime)
{
    const double c = 299792458.0;
    SimTime t = startTime;
    double doppler = (speed * fHz) / c;
    int paths = r.cosAoa[band].size();
    double attenuation = 1.00 / sqrt(static_cast<double>(paths));
    double re = 0, im = 0;
    for (int p = 0; p < paths; p++) {
        double phi = 2.00 * M_PI * (r.cosAoa[band][p] * doppler * t.dbl() - r.delay[band][p] * fHz);
        re = re + attenuation * cos(phi);
        im = im - attenuation * sin(phi);
    }
    return 10 * log10(re * re + im * im);
}

%file: harness.ned
import simu5g.common.binder.Binder;
import simu5g.stack.phy.medium.CellularRadioMedium;
import simu5g.common.carrierAggregation.CarrierAggregation;
import simu5g.stack.phy.channelmodel.Tr38901ChannelModel;

network Harness
{
    submodules:
        binder: Binder;
        radioMedium: CellularRadioMedium;
        carrierAggregation: CarrierAggregation;
        bsChannelModel: Tr38901ChannelModel;
        ueChannelModel: Tr38901ChannelModel;
        test: Test;
}

%inifile: omnetpp.ini
[General]
network = Harness
cmdenv-express-mode = false
cmdenv-log-prefix = ""
sim-time-limit = 1s

*.carrierAggregation.numComponentCarriers = 1
*.carrierAggregation.componentCarrier[0].carrierFrequency = 3.5GHz
*.carrierAggregation.componentCarrier[0].numBands = 10
**.cellInfoModule = ""
*.binder.printTrafficGeneratorConfig = false

# The fading parameters, stated rather than inherited.
**.fading = true
**.fadingType = "JAKES"
**.numFadingPaths = 6
**.delayRms = 363ns

%no-default-inifile: 1

%activity:
Checker c;
Binder *binder = harnessModule<Binder>(this, "binder");
auto *bs = harnessModule<StochasticChannelModel>(this, "bsChannelModel");
auto *ue = harnessModule<StochasticChannelModel>(this, "ueChannelModel");

StubEndpoint bsEndpoint, ueEndpoint;
ueEndpoint.channelModels[ue->getCarrierFrequency()] = ue;
const MacNodeId ueId = MacNodeId(1025);
bsEndpoint.nodeId = MacNodeId(1);
ueEndpoint.nodeId = ueId;
bsEndpoint.coord = inet::Coord(0, 0, 25);
ueEndpoint.coord = inet::Coord(120, 45, 1.5);
bsEndpoint.txPower = 40.0;
bsEndpoint.antennaGain = 8.0;
ueEndpoint.txPower = 23.0;
ueEndpoint.antennaGain = 0.0;
auto *medium = harnessModule<CellularRadioMedium>(this, "radioMedium");
StubRadioRegistration bsRadio(medium, MacNodeId(1), &bsEndpoint);
StubRadioRegistration ueRadio(medium, ueId, &ueEndpoint);

const int bands = bs->getNumBands();
const int paths = bs->par("numFadingPaths").intValue();
const double delayRms = bs->par("delayRms").doubleValue();
const double fHz = inet::units::values::Hz(bs->getCarrierFrequency()).get();
ChannelModelProbe bsProbe(bs), ueProbe(ue);

// Away from t = 0, so that the fading varies with the start time.
wait(0.010);

//
// --- the value ---
//
{
    // A fresh link: the first call draws the realization, and the value is the
    // Jakes sum over it.
    const LinkKey key(MacNodeId(1100));
    const double speed = 13.9;   // m/s, 50 km/h
    RngSnapshot snapshot(ue);
    double got3 = ue->jakesFading(ueProbe.jakesMap(), key, speed, 3, simTime());
    JakesRealization r = replayRealization(snapshot.rng(), bands, paths, delayRms);
    c.expectNear("the fading value is the Jakes sum over the drawn realization",
            got3, jakesGainDb(r, 3, speed, fHz, simTime().dbl()), 1e-9);

    // The realization covers every band, and each band has its own.
    double got8 = ue->jakesFading(ueProbe.jakesMap(), key, speed, 8, simTime());
    c.expectNear("...on every band, from that band's own paths",
            got8, jakesGainDb(r, 8, speed, fHz, simTime().dbl()), 1e-9);

    // The replay consumed exactly what the model consumed: the next draw agrees.
    c.check("the realization is drawn band by band, angle then delay, per path",
            ue->uniform(0, 1) == omnetpp::uniform(snapshot.rng(), 0, 1));
}
{
    // Drawn once. A second call on the same link, even on another band, draws
    // nothing and reuses the realization.
    const LinkKey key(MacNodeId(1101));
    ue->jakesFading(ueProbe.jakesMap(), key, 5.0, 0, simTime());
    unsigned long drawnBefore = ue->getRNG(0)->getNumbersDrawn();
    double a = ue->jakesFading(ueProbe.jakesMap(), key, 5.0, 0, simTime());
    double b = ue->jakesFading(ueProbe.jakesMap(), key, 5.0, 0, simTime());
    ue->jakesFading(ueProbe.jakesMap(), key, 5.0, 6, simTime());
    c.expectValue("a realization is drawn once and then reused",
            (long long)(ue->getRNG(0)->getNumbersDrawn() - drawnBefore), 0);
    c.check("the same link, band and instant give the same value", a == b);
}
{
    // Doppler, varied alone: the realization and the instant are fixed, only
    // the speed changes.
    const LinkKey key(MacNodeId(1102));
    RngSnapshot snapshot(ue);
    ue->jakesFading(ueProbe.jakesMap(), key, 0.0, 2, simTime());
    JakesRealization r = replayRealization(snapshot.rng(), bands, paths, delayRms);
    bool followsSpeed = true;
    for (double speed : {0.0, 1.0, 13.9, 33.3, 69.4}) {
        double got = ue->jakesFading(ueProbe.jakesMap(), key, speed, 2, simTime());
        if (fabs(got - jakesGainDb(r, 2, speed, fHz, simTime().dbl())) > 1e-9)
            followsSpeed = false;
    }
    c.check("the Doppler term is speed * f / c, at every speed", followsSpeed);

    // A stationary link is frozen in time; a moving one is not.
    double still = ue->jakesFading(ueProbe.jakesMap(), key, 0.0, 2, simTime());
    double moving = ue->jakesFading(ueProbe.jakesMap(), key, 30.0, 2, simTime());
    wait(0.005);
    double stillLater = ue->jakesFading(ueProbe.jakesMap(), key, 0.0, 2, simTime());
    double movingLater = ue->jakesFading(ueProbe.jakesMap(), key, 30.0, 2, simTime());
    c.check("a stationary link's fading does not change over time", still == stillLater);
    c.check("a moving link's fading does", moving != movingLater);
    c.expectNear("...and follows the same realization at the new instant",
            movingLater, jakesGainDb(r, 2, 30.0, fHz, simTime().dbl()), 1e-9);
}

//
// --- whose state: one realization per link ---
//
{
    // A DL CQI at the base station and the UE's decoding are the same link,
    // evaluated from its two ends, through the real entry point getRSRP().
    UserControlInfo data = controlInfo(DL, DATAPKT, MacNodeId(1), ueId, bsEndpoint.coord);
    const LinkKey link(MacNodeId(1), ueId);

    bs->getRSRP(bsProbe.whatIfLink(&ueEndpoint, dlCqiTransmission(&bsEndpoint, ueId)), 30.0);

    // The path loss and shadowing of this harness may draw on their own
    // account, so "draws nothing" is measured against an identical evaluation
    // at once.
    unsigned long before = ue->getRNG(0)->getNumbersDrawn();
    ue->getRSRP(ueProbe.linkFor(&ueEndpoint, &data), 30.0);
    long long decoderDraws = ue->getRNG(0)->getNumbersDrawn() - before;
    before = ue->getRNG(0)->getNumbersDrawn();
    ue->getRSRP(ueProbe.linkFor(&ueEndpoint, &data), 30.0);
    long long repeatDraws = ue->getRNG(0)->getNumbersDrawn() - before;

    c.check("every channel model on the carrier reads the same Jakes map, the medium's",
            &bsProbe.jakesMap() == &ueProbe.jakesMap());
    c.expectValue("the UE decoding draws no fading paths of its own: the DL CQI drew the link's",
            decoderDraws, repeatDraws);
    c.check("the link has one realization, whichever end drew it", bsProbe.jakesMap().count(link) == 1);

    // The same link, band, speed and instant, through the two views.
    double cqiView = bs->jakesFading(bsProbe.jakesMap(), link, 3.0, 4, simTime());
    double decoderView = ue->jakesFading(ueProbe.jakesMap(), link, 3.0, 4, simTime());
    c.check("the channel a DL CQI describes is the channel the UE decodes through",
            cqiView == decoderView,
            "cqi=" + std::to_string(cqiView) + " decoder=" + std::to_string(decoderView));

    // The uplink of the same pair, received at the base station through the
    // same entry point: it draws no fading paths of its own either.
    UserControlInfo ul = controlInfo(UL, DATAPKT, ueId, MacNodeId(1), ueEndpoint.coord);
    size_t entries = bsProbe.jakesMap().size();
    before = bs->getRNG(0)->getNumbersDrawn();
    bs->getRSRP(bsProbe.linkFor(&bsEndpoint, &ul), 30.0);
    long long uplinkDraws = bs->getRNG(0)->getNumbersDrawn() - before;
    before = bs->getRNG(0)->getNumbersDrawn();
    bs->getRSRP(bsProbe.linkFor(&bsEndpoint, &ul), 30.0);
    long long uplinkRepeatDraws = bs->getRNG(0)->getNumbersDrawn() - before;
    c.expectValue("...and the uplink is the same realization: a link has one, whichever direction",
            uplinkDraws, uplinkRepeatDraws);
    c.check("...and no new entry", bsProbe.jakesMap().size() == entries && bsProbe.jakesMap().count(link) == 1);
}
{
    // A background UE has no radio on the medium, but its link to the base
    // station is a link like any other: its CQIs, DL and UL, are computed at
    // the base station over one realization, kept once per link.
    const MacNodeId bgUeId = MacNodeId(BGUE_MIN_ID + 3);
    const LinkKey link(bgUeId, MacNodeId(1));
    AirFrame frame;
    UserControlInfo dl = controlInfo(DL, FEEDBACKPKT, bgUeId, MacNodeId(1), inet::Coord(80, 60, 1.5));
    dl.setTxPower(40.0);
    UserControlInfo ul = dl;
    ul.setDirection(UL);
    ul.setTxPower(23.0);

    bs->getSINR_bgUe(&bsEndpoint, &frame, &dl, 0.0);
    c.check("a background UE's DL CQI draws the fading paths of its link to the base station",
            bsProbe.jakesMap().count(link) == 1);

    // what the UL CQI draws, against what an identical evaluation draws at once
    // (the path loss may draw on its own account)
    unsigned long before = bs->getRNG(0)->getNumbersDrawn();
    bs->getSINR_bgUe(&bsEndpoint, &frame, &ul, 0.0);
    long long ulDraws = bs->getRNG(0)->getNumbersDrawn() - before;
    before = bs->getRNG(0)->getNumbersDrawn();
    bs->getSINR_bgUe(&bsEndpoint, &frame, &ul, 0.0);
    long long repeatDraws = bs->getRNG(0)->getNumbersDrawn() - before;
    c.expectValue("...and its UL CQI fades by the same paths, drawing none of its own", ulDraws, repeatDraws);
}

//
// --- rayleighFading, pinned ---
//
{
    unsigned long drawnBefore = bs->getRNG(0)->getNumbersDrawn();
    bool sharedAcrossNodes = true, isTheTable = true;
    std::vector<double> before;
    for (int band = 0; band < bands; band++) {
        double v = bs->rayleighFading(MacNodeId(1025), band);
        before.push_back(v);
        if (v != bs->rayleighFading(MacNodeId(1777), band) || v != ue->rayleighFading(MacNodeId(1025), band))
            sharedAcrossNodes = false;
        if (v != 10 * log10(binder->phyPisaData.getChannel(band)))
            isTheTable = false;
    }
    wait(0.050);
    bool timeInvariant = true;
    for (int band = 0; band < bands; band++)
        if (bs->rayleighFading(MacNodeId(1025), band) != before[band])
            timeInvariant = false;

    c.check("Rayleigh fading is the shared PhyPisaData table, indexed by band", isTheTable);
    c.check("PINNED DEFECT: ...so every node on a band sees the same value", sharedAcrossNodes);
    c.check("...the value never changes over time", timeInvariant);
    c.expectValue("...and no random number is drawn",
            (long long)(bs->getRNG(0)->getNumbersDrawn() - drawnBefore), 0);
}

c.summary();

%contains: stdout
modelchecks=21 modelfailures=0

%not-contains: stdout
FAILED
