%description:

The Binder's uplink transmission map with carriers of different numerologies.

The map keeps, per carrier, the uplink transmissions of the current slot and
of the previous one. The eNB MAC rotates it at every time step it ticks at
(once per time step, guarded by getLastUpdateUlTransmissionInfo()), and a
reception decoded at the end of a slot finds the interfering transmissions of
that slot in the previous-slot map.

A carrier's slot ends only at its own slot boundaries. With two carriers of
numerologies 0 (1 ms slots) and 1 (0.5 ms slots), the MAC ticks every 0.5 ms;
the 1 ms carrier must be rotated at its own slot ends only, or its
transmissions are rotated away before the end of the slot they were sent in,
and the uplink interference on that carrier is lost.

%includes:
#include <string>
#include "SchedulerTestUtil.h"
#include "simu5g/common/binder/Binder.h"

%global:
using namespace simu5g;
using namespace simu5g::unittest;

// Whether the map has a transmission of 'ue' on 'band'.
static bool holds(const std::vector<std::vector<UeAllocationInfo>> *map, unsigned int band, MacNodeId ue)
{
    if (map == nullptr || band >= map->size())
        return false;
    for (const auto& info : (*map)[band])
        if (info.nodeId == ue)
            return true;
    return false;
}

%file: harness.ned
import simu5g.common.binder.Binder;

network Harness
{
    submodules:
        binder: Binder;
        test: Test;
}

%inifile: omnetpp.ini
[General]
network = Harness
cmdenv-express-mode = false
cmdenv-log-prefix = ""
sim-time-limit = 1s
*.binder.printTrafficGeneratorConfig = false

%no-default-inifile: 1

%activity:
Checker c;
Binder *binder = check_and_cast<Binder *>(getSimulation()->getSystemModule()->getSubmodule("binder"));

const GHz slow = GHz(2.0), fast = GHz(3.5);
binder->registerCarrier(slow, 6, 0);  // 1 ms slots
binder->registerCarrier(fast, 6, 1);  // 0.5 ms slots
const MacNodeId ueSlow = MacNodeId(1025), ueFast = MacNodeId(1026);

// What the eNB MAC does at each of its time steps.
auto macTick = [&] {
    if (binder->getLastUpdateUlTransmissionInfo() < simTime())
        binder->initAndResetUlTransmissionInfo();
};
auto store = [&](GHz carrier, MacNodeId ue) {
    RbMap rbMap;
    rbMap[MACRO][0] = 1;
    binder->storeUlTransmissionMap(carrier, MACRO, rbMap, ue, MacCellId(1), static_cast<PhyBase *>(nullptr), UL);
};

// t = 1 ms: a slot boundary of both carriers; one transmission on each.
wait(SimTime(1, SIMTIME_MS));
macTick();
store(slow, ueSlow);
store(fast, ueFast);

// t = 1.5 ms: the 0.5 ms carrier's slot ends, the 1 ms carrier's does not.
wait(SimTime(500, SIMTIME_US));
macTick();
c.check("the 0.5 ms carrier's slot has ended: its transmission is in its previous-slot map",
        holds(binder->getUlTransmissionMap(fast, PREV_TTI), 0, ueFast));
c.check("the 1 ms carrier's slot has not ended: its transmission is still in its current-slot map",
        holds(binder->getUlTransmissionMap(slow, CURR_TTI), 0, ueSlow));

// t = 2 ms: the 1 ms carrier's slot ends, and a reception decoded now reads its
// previous-slot map.
wait(SimTime(500, SIMTIME_US));
macTick();
c.check("at the end of the 1 ms carrier's slot, its previous-slot map holds the transmissions of that slot",
        holds(binder->getUlTransmissionMap(slow, PREV_TTI), 0, ueSlow));

c.summary();

%contains: stdout
modelchecks=3 modelfailures=0

%not-contains: stdout
FAILED
