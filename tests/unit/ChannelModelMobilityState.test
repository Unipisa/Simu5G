%description:

The mobility state StochasticChannelModel keeps per node and per link, and the
call-order invariant getRSRP() documents about it.

Three pieces of state. positionHistory_ is a two-entry window per node -- the
past position and the current one -- from which computeSpeed() derives the
speed that drives Doppler in Jakes fading and the shadowing recurrence. The
correlation point, per link, is where the LOS state was last decided. The
position history is not quite what its name suggests, in two respects, both
pinned:

 - the first position recorded in a TTI wins; a later one in the same TTI is
   ignored, not merged;
 - computeSpeed() measures from the older of the two recorded positions to the
   position it is asked about, not to the latest recorded one, and with only
   one recorded position it returns 0 however old that position is.

computeSpeed() throws on two history entries at the same instant. That state
cannot be produced through updatePositionHistory(), whose same-TTI early
return refuses the second entry, so the test shows both halves: the update
path refuses it, and the guard still rejects it if it is built directly.

The invariant: getRSRP() reads the speed before calling getAttenuation(),
which appends to the history, because afterwards the window has moved and the
speed -- and with it the fading -- would be different. The comment at the call
site is the only thing enforcing that. Here both orders' speeds are computed,
shown to differ, and the fading getRSRP() actually applied -- the difference
between a call with fading and one without, in the same TTI -- is shown to be
the Jakes fading at the documented one.

%includes:
#include "SchedulerTestUtil.h"
#include "ChannelModelTestUtil.h"

%global:
using namespace simu5g;
using namespace simu5g::unittest;
using inet::Coord;

%file: harness.ned
import simu5g.common.binder.Binder;
import simu5g.stack.phy.medium.CellularRadioMedium;
import simu5g.common.carrierAggregation.CarrierAggregation;
import simu5g.stack.phy.channelmodel.Tr38901ChannelModel;

network Harness
{
    submodules:
        binder: Binder;
        radioMedium: CellularRadioMedium;
        carrierAggregation: CarrierAggregation;
        bsChannelModel: Tr38901ChannelModel;
        test: Test;
}

%inifile: omnetpp.ini
[General]
network = Harness
cmdenv-express-mode = false
cmdenv-log-prefix = ""
sim-time-limit = 100s

*.carrierAggregation.numComponentCarriers = 1
*.carrierAggregation.componentCarrier[0].carrierFrequency = 3.5GHz
*.carrierAggregation.componentCarrier[0].numBands = 10
**.cellInfoModule = ""
*.binder.printTrafficGeneratorConfig = false

**.scenario = "URBAN_MICROCELL"
**.correlationDistance = 50m
**.dynamicLos = false
**.fixedLos = true
**.shadowing = true
**.fading = true
**.fadingType = "JAKES"

%no-default-inifile: 1

%activity:
Checker c;
auto *m = harnessModule<StochasticChannelModel>(this, "bsChannelModel");
StubEndpoint own;
m->setPhy(&own);
ChannelModelProbe probe(m);
const double dcorr = m->par("correlationDistance").doubleValue();

wait(1.0);

//
// --- the position window ---
//
{
    const MacNodeId id = MacNodeId(1100);
    auto& history = probe.positionHistory();
    probe.updatePositionHistory(id, Coord(0, 0, 1.5));
    c.expectValue("a node's first position starts its history", (long long)history[id].size(), 1);
    probe.updatePositionHistory(id, Coord(99, 0, 1.5));
    c.check("a second position in the same TTI is ignored -- the first one wins",
            history[id].size() == 1 && history[id].back().second == Coord(0, 0, 1.5));
    wait(0.5);
    probe.updatePositionHistory(id, Coord(5, 0, 1.5));
    c.expectValue("the next TTI adds the current position to the past one", (long long)history[id].size(), 2);
    wait(0.5);
    probe.updatePositionHistory(id, Coord(10, 0, 1.5));
    c.check("the window keeps two: the oldest is dropped",
            history[id].size() == 2 && history[id].front().second == Coord(5, 0, 1.5)
            && history[id].back().second == Coord(10, 0, 1.5));
}

//
// --- speed ---
//
{
    c.expectNear("no history, no speed", probe.computeSpeed(MacNodeId(1101), Coord(3, 4, 0)), 0, 0);

    const MacNodeId once = MacNodeId(1102);
    probe.updatePositionHistory(once, Coord(0, 0, 1.5));
    wait(2.0);
    c.expectNear("one recorded position gives no speed, however old it is",
            probe.computeSpeed(once, Coord(100, 0, 1.5)), 0, 0);

    // Two recorded positions: the speed is measured from the older one to the
    // position asked about, over the time since the older one.
    const MacNodeId id = MacNodeId(1103);
    probe.updatePositionHistory(id, Coord(0, 0, 1.5));
    simtime_t t0 = simTime();
    wait(1.0);
    probe.updatePositionHistory(id, Coord(8, 0, 1.5));
    wait(1.0);
    const Coord asked(30, 40, 1.5);                        // 50 m from the older position
    double expected = Coord(0, 0, 1.5).distance(asked) / (simTime() - t0).dbl();
    c.expectNear("speed = distance from the older recorded position to the one asked about, over the time",
            probe.computeSpeed(id, asked), expected, 1e-12);
    c.check("...which is not the speed from the latest recorded position",
            probe.computeSpeed(id, asked) != Coord(8, 0, 1.5).distance(asked) / 1.0);
    c.expectNear("asked about the older position itself, the speed is 0",
            probe.computeSpeed(id, Coord(0, 0, 1.5)), 0, 0);

    // Two entries at one instant: the update path cannot make it, the guard
    // rejects it anyway.
    const MacNodeId twin = MacNodeId(1104);
    probe.updatePositionHistory(twin, Coord(0, 0, 1.5));
    probe.updatePositionHistory(twin, Coord(7, 0, 1.5));
    c.expectValue("the update path never records two positions at one instant",
            (long long)probe.positionHistory()[twin].size(), 1);
    probe.positionHistory()[twin].push(std::make_pair(simTime(), Coord(7, 0, 1.5)));
    c.expectRejected("two history entries at one instant are rejected", [&] {
        probe.computeSpeed(twin, Coord(20, 0, 1.5));
    });
}

//
// --- the correlation point ---
//
{
    const LinkKey key(MacNodeId(1105));
    auto& points = probe.lastCorrelationPoint();
    double first = probe.computeCorrelationDistance(key, Coord(0, 0, 1.5));
    c.check("a link with no correlation point is at distance 0, and reading it records nothing",
            first == 0 && points.count(key) == 0);
    probe.updateCorrelationDistance(key, Coord(0, 0, 1.5));
    c.check("the first update records the point", points.count(key) == 1 && points[key].second == Coord(0, 0, 1.5));
    wait(1.0);
    double later = probe.computeCorrelationDistance(key, Coord(30, 0, 1.5));
    c.check("...and afterwards measures from it without moving it",
            later == 30 && points[key].second == Coord(0, 0, 1.5));

    probe.updateCorrelationDistance(key, Coord(30, 0, 1.5));
    c.check("within the correlation distance the point stays", points[key].second == Coord(0, 0, 1.5));
    probe.updateCorrelationDistance(key, Coord(dcorr + 1, 0, 1.5));
    c.check("beyond it, in a later TTI, the point moves to where the node is now",
            points[key].second == Coord(dcorr + 1, 0, 1.5) && points[key].first == simTime());
    probe.updateCorrelationDistance(key, Coord(500, 0, 1.5));
    c.check("but not twice in one TTI, however far the node is",
            points[key].second == Coord(dcorr + 1, 0, 1.5));
}

//
// --- getRSRP reads the speed before getAttenuation moves the window ---
//
{
    const MacNodeId id = MacNodeId(1106);
    probe.updatePositionHistory(id, Coord(0, 0, 1.5));
    wait(1.0);
    probe.updatePositionHistory(id, Coord(10, 0, 1.5));
    wait(1.0);
    const Coord now(40, 0, 1.5);

    RadioLink link;
    link.dir = DL;
    link.txId = MacNodeId(1);
    link.rxId = id;
    link.txCoord = Coord(-200, 0, 10);
    link.rxCoord = now;
    link.stateKey = LinkKey(id);
    link.stateNodeId = id;
    link.stateCoord = now;
    link.txIsBaseStation = false;   // no angular term: this is about speed only

    // The two orders' speeds, from the state before the call.
    double documented = probe.computeSpeed(id, now);         // before getAttenuation
    std::vector<double> withFading = m->getRSRP(link, 30.0);
    double reversed = probe.computeSpeed(id, now);           // after it moved the window
    c.check("the window has moved, so the two orders give different speeds",
            documented != reversed,
            "before=" + std::to_string(documented) + " after=" + std::to_string(reversed));

    // What getRSRP applied: the same call in the same TTI without fading.
    probe.fading() = false;
    std::vector<double> withoutFading = m->getRSRP(link, 30.0);
    probe.fading() = true;

    bool usedDocumented = true, differsFromReversed = false;
    for (size_t band = 0; band < withFading.size(); band++) {
        double applied = withFading[band] - withoutFading[band];
        if (fabs(applied - m->jakesFading(link.stateKey, id, documented, band, false)) > 1e-9)
            usedDocumented = false;
        if (fabs(applied - m->jakesFading(link.stateKey, id, reversed, band, false)) > 1e-9)
            differsFromReversed = true;
    }
    c.check("getRSRP applies the Jakes fading at the speed read before getAttenuation", usedDocumented);
    c.check("...which is not the fading the other order would have produced", differsFromReversed);
}

c.summary();

%contains: stdout
modelchecks=20 modelfailures=0

%not-contains: stdout
FAILED
