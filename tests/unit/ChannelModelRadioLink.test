%description:

The RadioLink builders of StochasticChannelModel: linkFor(), which turns a
received packet's control information into the link to evaluate, and
cellularLink(), its node-id form. A RadioLink carries, as data, which end
transmits and whose channel state to use -- so these two functions are where
those choices are made. (The link budget is not part of the link: it is the
two radios'.)

The link itself is linkKey: the node ids of its two radios. It is what the
state the medium keeps per link -- whether the link is in line of sight -- is
indexed by, and it is the same key from either end. linkFor() takes the
frame's source as the other end and the local radio as this one, which also
names the receiving UE of a beacon, a frame with no destination.

linkFor() is checked for the four cases it distinguishes: downlink data, which
the UE decodes; uplink data, which the base station decodes; and the feedback
variants, which the base station evaluates for a CQI. In each: the endpoints,
the geometry, and the model's own channel state -- keyed on the UE, fed by the
UE's position, and read from the UE's side only for a downlink CQI.

The property that matters most is stated on its own. The link a downlink CQI
is computed on, at the base station, and the link the UE decodes downlink data
on are the same physical link evaluated from its two ends: same endpoints,
positions and state key, differing in nothing but where the state is read.
That is the geometric half of what the Jakes and shadowing tests assert about
the state itself.

%includes:
#include "SchedulerTestUtil.h"
#include "ChannelModelTestUtil.h"

%global:
using namespace simu5g;
using namespace simu5g::unittest;
using inet::Coord;

// The control information a packet from 'source' to 'dest' carries, with the
// sender's position.
static UserControlInfo controlInfo(Direction dir, LtePhyFrameType type, MacNodeId source,
        MacNodeId dest, const Coord& senderPosition)
{
    UserControlInfo info;
    info.setDirection(dir);
    info.setFrameType(type);
    info.setSourceId(source);
    info.setDestId(dest);
    info.setCoord(senderPosition);
    return info;
}

static bool sameLinkExceptSide(const RadioLink& a, const RadioLink& b)
{
    return a.linkKey == b.linkKey && a.txId == b.txId && a.rxId == b.rxId && a.txCoord == b.txCoord && a.rxCoord == b.rxCoord
           && a.stateKey == b.stateKey && a.stateNodeId == b.stateNodeId && a.stateCoord == b.stateCoord
           && a.txIsBaseStation == b.txIsBaseStation
           && a.cellId == b.cellId && a.dir == b.dir;
}

%file: harness.ned
import simu5g.common.binder.Binder;
import simu5g.stack.phy.medium.CellularRadioMedium;
import simu5g.common.carrierAggregation.CarrierAggregation;
import simu5g.stack.phy.channelmodel.Tr38901ChannelModel;

network Harness
{
    submodules:
        binder: Binder;
        radioMedium: CellularRadioMedium;
        carrierAggregation: CarrierAggregation;
        bsChannelModel: Tr38901ChannelModel;
        ueChannelModel: Tr38901ChannelModel;
        test: Test;
}

%inifile: omnetpp.ini
[General]
network = Harness
cmdenv-express-mode = false
cmdenv-log-prefix = ""
sim-time-limit = 1s
*.carrierAggregation.numComponentCarriers = 1
*.carrierAggregation.componentCarrier[0].carrierFrequency = 3.5GHz
*.carrierAggregation.componentCarrier[0].numBands = 10
**.cellInfoModule = ""
*.binder.printTrafficGeneratorConfig = false

%no-default-inifile: 1

%activity:
Checker c;
auto *bs = harnessModule<StochasticChannelModel>(this, "bsChannelModel");
auto *ue = harnessModule<StochasticChannelModel>(this, "ueChannelModel");

const MacNodeId enbId = MacNodeId(1), ueId = MacNodeId(1025);
const Coord enbPos(0, 0, 25), uePos(120, 45, 1.5);
StubEndpoint enbEndpoint, ueEndpoint;
enbEndpoint.coord = enbPos;
ueEndpoint.coord = uePos;
enbEndpoint.nodeId = enbId;
ueEndpoint.nodeId = ueId;
bs->setPhy(&enbEndpoint);
ue->setPhy(&ueEndpoint);
ChannelModelProbe atEnb(bs), atUe(ue);

//
// --- linkFor() ---
//
{
    // Downlink data, decoded at the UE: the base station sent it.
    UserControlInfo info = controlInfo(DL, DATAPKT, enbId, ueId, enbPos);
    RadioLink l = atUe.linkFor(&info);
    c.check("DL data: the base station transmits to the UE",
            l.txId == enbId && l.rxId == ueId && l.txIsBaseStation && l.cellId == enbId);
    c.check("...from the sender's position to the decoder's own", l.txCoord == enbPos && l.rxCoord == uePos);
    c.check("...and the UE's state, read from the decoder's own maps",
            l.stateKey == LinkKey(ueId) && l.stateNodeId == ueId && l.stateCoord == uePos && !l.useUeSideMaps);
    c.check("...and the link is the base station and the UE, by their node ids", l.linkKey == LinkKey(enbId, ueId));
}
{
    // Uplink data, decoded at the base station: the UE sent it.
    UserControlInfo info = controlInfo(UL, DATAPKT, ueId, enbId, uePos);
    RadioLink l = atEnb.linkFor(&info);
    c.check("UL data: the UE transmits to the base station",
            l.txId == ueId && l.rxId == enbId && !l.txIsBaseStation && l.cellId == enbId);
    c.check("...from the sender's position to the decoder's own", l.txCoord == uePos && l.rxCoord == enbPos);
    c.check("...and the UE's state -- always the UE's, fed by the UE's position -- from the base station's maps",
            l.stateKey == LinkKey(ueId) && l.stateNodeId == ueId && l.stateCoord == uePos && !l.useUeSideMaps);
    c.check("...the same link, named from the other end", l.linkKey == LinkKey(enbId, ueId));
}
{
    // Feedback for a downlink CQI, evaluated at the base station: the UE sent
    // the report, but the link being evaluated is the downlink.
    UserControlInfo info = controlInfo(DL, FEEDBACKPKT, ueId, enbId, uePos);
    RadioLink l = atEnb.linkFor(&info);
    c.check("DL CQI: still the downlink, the base station transmitting to the UE",
            l.txId == enbId && l.rxId == ueId && l.txIsBaseStation);
    c.check("...evaluated where the report arrived, from the UE's reported position",
            l.txCoord == enbPos && l.rxCoord == uePos && l.stateCoord == uePos);
    c.check("...and the state read from the UE's side", l.useUeSideMaps);
    c.check("...on the same link", l.linkKey == LinkKey(enbId, ueId));
}
{
    // Feedback for an uplink CQI is the uplink link, with the base station's
    // own state.
    UserControlInfo info = controlInfo(UL, FEEDBACKPKT, ueId, enbId, uePos);
    UserControlInfo data = controlInfo(UL, DATAPKT, ueId, enbId, uePos);
    RadioLink uplinkData = atEnb.linkFor(&data);
    RadioLink l = atEnb.linkFor(&info);
    c.check("UL CQI: the same link as the uplink data it describes, state included",
            sameLinkExceptSide(l, uplinkData) && !l.useUeSideMaps);
}
{
    // A beacon names no destination: the link is its sender and the radio
    // that received it. The model's own state is still keyed on the UE the
    // frame names, which is none.
    UserControlInfo info = controlInfo(DL, BEACONPKT, enbId, NODEID_NONE, enbPos);
    RadioLink l = atUe.linkFor(&info);
    c.check("a beacon: the link is its sender and the receiving radio", l.linkKey == LinkKey(enbId, ueId));
    c.check("...while the model's own state is keyed on the missing destination", l.stateKey == LinkKey(NODEID_NONE));
}
{
    // The property the selection exists for, at the level of the link itself.
    UserControlInfo decode = controlInfo(DL, DATAPKT, enbId, ueId, enbPos);
    UserControlInfo report = controlInfo(DL, FEEDBACKPKT, ueId, enbId, uePos);
    RadioLink decoderView = atUe.linkFor(&decode);
    RadioLink cqiView = atEnb.linkFor(&report);
    c.check("the link a DL CQI is computed on is the link the UE decodes on, seen from the other end",
            sameLinkExceptSide(cqiView, decoderView));
    c.check("...both reading the UE's state -- the decoder its own, the base station the UE's",
            !decoderView.useUeSideMaps && cqiView.useUeSideMaps);
}

//
// --- cellularLink() ---
//
{
    RadioLink dl = atUe.cellularLink(ueId, DL, enbPos, false);
    c.check("cellularLink, DL: the other end transmits, the local end is the UE",
            dl.txIsBaseStation && dl.txCoord == enbPos && dl.rxCoord == uePos && dl.rxId == ueId);
    c.check("...and the UE's state is fed by the local position",
            dl.stateKey == LinkKey(ueId) && dl.stateNodeId == ueId && dl.stateCoord == uePos);
    c.check("...and the link is the UE and an unnamed base station", dl.linkKey == LinkKey(ueId, NODEID_NONE));

    RadioLink ul = atEnb.cellularLink(ueId, UL, uePos, false);
    c.check("cellularLink, UL: the UE at the given position transmits to the local base station",
            !ul.txIsBaseStation && ul.txCoord == uePos && ul.rxCoord == enbPos && ul.txId == ueId);
    c.check("...and the UE's state is fed by the given position", ul.stateCoord == uePos);
    c.check("...and the link is the UE and the local base station", ul.linkKey == LinkKey(ueId, enbId));

    c.check("cellularLink takes the side of the state from its argument",
            atEnb.cellularLink(ueId, DL, uePos, true).useUeSideMaps
            && !atEnb.cellularLink(ueId, DL, uePos, false).useUeSideMaps);
}

c.summary();

%contains: stdout
modelchecks=24 modelfailures=0

%not-contains: stdout
FAILED
