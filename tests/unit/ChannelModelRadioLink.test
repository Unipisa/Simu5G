%description:

The RadioLink builders of StochasticChannelModel: linkFor(), which turns a
received packet's control information into the link to evaluate,
whatIfLink(), the link of a transmission that is not on the medium, and
cellularLink(), linkFor()'s node-id form. A RadioLink carries, as data, which
end transmits and whose channel state to use -- so these functions are where
those choices are made. (The link budget is not part of the link: it is the
two radios'.)

The link itself is linkKey: the node ids of its two radios, txId and rxId. It is what the
state the medium keeps per link -- whether the link is in line of sight -- is
indexed by, and it is the same key from either end. linkFor() takes the
frame's source as the other end and the local radio as this one, which also
names the receiving UE of a beacon, a frame with no destination.

linkFor() is checked for the cases it distinguishes: downlink data, which the
UE decodes; uplink data, which the base station decodes; and the uplink CQI,
which the base station evaluates from a UE's report. whatIfLink() is checked
for the downlink CQI, the base station's what-if. In each: the endpoints, the
geometry, and the link's mobile end, the UE.

The property that matters most is stated on its own. The link a downlink CQI
is computed on, at the base station, and the link the UE decodes downlink data
on are the same physical link evaluated from its two ends: same endpoints,
positions and mobile end. The two ends see the same link, whose state
the radio medium keeps once. That is the geometric half of what the Jakes and shadowing
tests assert about the state itself.

%includes:
#include "SchedulerTestUtil.h"
#include "ChannelModelTestUtil.h"

%global:
using namespace simu5g;
using namespace simu5g::unittest;
using inet::Coord;

// The control information a packet from 'source' to 'dest' carries.
static UserControlInfo controlInfo(Direction dir, LtePhyFrameType type, MacNodeId source,
        MacNodeId dest)
{
    UserControlInfo info;
    info.setDirection(dir);
    info.setFrameType(type);
    info.setSourceId(source);
    info.setDestId(dest);
    return info;
}

static bool sameLink(const RadioLink& a, const RadioLink& b)
{
    return a.linkKey == b.linkKey && a.txId == b.txId && a.rxId == b.rxId && a.txCoord == b.txCoord && a.rxCoord == b.rxCoord
           && a.stateNodeId == b.stateNodeId
           && a.txIsBaseStation == b.txIsBaseStation
           && a.cellId == b.cellId && a.dir == b.dir;
}

%file: harness.ned
import simu5g.common.binder.Binder;
import simu5g.stack.phy.medium.CellularRadioMedium;
import simu5g.common.carrierAggregation.CarrierAggregation;
import simu5g.stack.phy.channelmodel.Tr38901ChannelModel;

network Harness
{
    submodules:
        binder: Binder;
        radioMedium: CellularRadioMedium;
        carrierAggregation: CarrierAggregation;
        bsChannelModel: Tr38901ChannelModel;
        ueChannelModel: Tr38901ChannelModel;
        test: Test;
}

%inifile: omnetpp.ini
[General]
network = Harness
cmdenv-express-mode = false
cmdenv-log-prefix = ""
sim-time-limit = 1s
*.carrierAggregation.numComponentCarriers = 1
*.carrierAggregation.componentCarrier[0].carrierFrequency = 3.5GHz
*.carrierAggregation.componentCarrier[0].numBands = 10
**.cellInfoModule = ""
*.binder.printTrafficGeneratorConfig = false

%no-default-inifile: 1

%activity:
Checker c;
auto *bs = harnessModule<StochasticChannelModel>(this, "bsChannelModel");
auto *ue = harnessModule<StochasticChannelModel>(this, "ueChannelModel");

const MacNodeId enbId = MacNodeId(1), ueId = MacNodeId(1025);
const Coord enbPos(0, 0, 25), uePos(120, 45, 1.5);
StubEndpoint enbEndpoint, ueEndpoint;
enbEndpoint.coord = enbPos;
ueEndpoint.coord = uePos;
enbEndpoint.nodeId = enbId;
ueEndpoint.nodeId = ueId;
ChannelModelProbe atEnb(bs), atUe(ue);

//
// --- linkFor() ---
//
{
    // Downlink data, decoded at the UE: the base station sent it.
    UserControlInfo info = controlInfo(DL, DATAPKT, enbId, ueId);
    RadioLink l = atUe.linkFor(&ueEndpoint, &info, enbPos);
    c.check("DL data: the base station transmits to the UE",
            l.txId == enbId && l.rxId == ueId && l.txIsBaseStation && l.cellId == enbId);
    c.check("...from the sender's position to the decoder's own", l.txCoord == enbPos && l.rxCoord == uePos);
    c.check("...and the UE is the mobile end",
            l.stateNodeId == ueId);
    c.check("...and the link is the base station and the UE, by their node ids", l.linkKey == LinkKey(enbId, ueId));
}
{
    // Uplink data, decoded at the base station: the UE sent it.
    UserControlInfo info = controlInfo(UL, DATAPKT, ueId, enbId);
    RadioLink l = atEnb.linkFor(&enbEndpoint, &info, uePos);
    c.check("UL data: the UE transmits to the base station",
            l.txId == ueId && l.rxId == enbId && !l.txIsBaseStation && l.cellId == enbId);
    c.check("...from the sender's position to the decoder's own", l.txCoord == uePos && l.rxCoord == enbPos);
    c.check("...and the mobile end is always the UE",
            l.stateNodeId == ueId);
    c.check("...the same link, named from the other end", l.linkKey == LinkKey(enbId, ueId));
}
{
    // A downlink CQI, computed at the base station from the UE's report: the
    // link being evaluated is the downlink -- a what-if, a transmission of the
    // base station to where the UE is now (whatIfLink()).
    RadioLink l = atEnb.whatIfLink(&ueEndpoint, dlCqiTransmission(&enbEndpoint, ueId));
    c.check("DL CQI: still the downlink, the base station transmitting to the UE",
            l.txId == enbId && l.rxId == ueId && l.txIsBaseStation);
    c.check("...from the base station to where the UE is now",
            l.txCoord == enbPos && l.rxCoord == uePos);
    c.check("...on the same link", l.linkKey == LinkKey(enbId, ueId));
}
{
    // Feedback for an uplink CQI is the uplink link.
    UserControlInfo info = controlInfo(UL, FEEDBACKPKT, ueId, enbId);
    UserControlInfo data = controlInfo(UL, DATAPKT, ueId, enbId);
    RadioLink uplinkData = atEnb.linkFor(&enbEndpoint, &data, uePos);
    RadioLink l = atEnb.linkFor(&enbEndpoint, &info, uePos);
    c.check("UL CQI: the same link as the uplink data it describes, mobile end included",
            sameLink(l, uplinkData));
}
{
    // A beacon names no destination: the link is its sender and the radio
    // that received it. The mobile end is still the UE the frame names,
    // which is none.
    UserControlInfo info = controlInfo(DL, BEACONPKT, enbId, NODEID_NONE);
    RadioLink l = atUe.linkFor(&ueEndpoint, &info, enbPos);
    c.check("a beacon: the link is its sender and the receiving radio",
            l.txId == enbId && l.rxId == ueId && l.linkKey == LinkKey(enbId, ueId));
    c.check("...while the mobile end is the missing destination", l.stateNodeId == NODEID_NONE);
}
{
    // The two ends see the same link, at the level of the link itself.
    UserControlInfo decode = controlInfo(DL, DATAPKT, enbId, ueId);
    RadioLink decoderView = atUe.linkFor(&ueEndpoint, &decode, enbPos);
    RadioLink cqiView = atEnb.whatIfLink(&ueEndpoint, dlCqiTransmission(&enbEndpoint, ueId));
    c.check("the link a DL CQI is computed on is the link the UE decodes on, seen from the other end",
            sameLink(cqiView, decoderView));
}

//
// --- cellularLink() ---
//
{
    RadioLink dl = atUe.cellularLink(&ueEndpoint, ueId, DL, enbPos);
    c.check("cellularLink, DL: the other end transmits, the local end is the UE",
            dl.txIsBaseStation && dl.txCoord == enbPos && dl.rxCoord == uePos && dl.rxId == ueId);
    c.check("...and the UE is the mobile end",
            dl.stateNodeId == ueId);
    c.check("...and the link is the UE and an unnamed base station", dl.linkKey == LinkKey(ueId, NODEID_NONE));

    RadioLink ul = atEnb.cellularLink(&enbEndpoint, ueId, UL, uePos);
    c.check("cellularLink, UL: the UE at the given position transmits to the local base station",
            !ul.txIsBaseStation && ul.txCoord == uePos && ul.rxCoord == enbPos && ul.txId == ueId);
    c.check("...and the UE is the mobile end", ul.stateNodeId == ueId);
    c.check("...and the link is the UE and the local base station, named by its own radio",
            ul.rxId == enbId && ul.linkKey == LinkKey(ueId, enbId));
}

c.summary();

%contains: stdout
modelchecks=21 modelfailures=0

%not-contains: stdout
FAILED
