%description:

The random term of an indoor UE's building penetration loss: sigma_P times a
standard-normal deviate that is the UE's own (TR 38.901 v16.1.0 7.4.3, "The
O2I penetration is UT-specifically generated"), the same in every evaluation
of each of its links, at either end, and none for a UE outdoors.

Checked with the TR 38.901 low-loss model at 28 GHz, sigma_P = 4.4 dB (Table
7.4.3-2): raising the UE's deviate from 0 to 1 raises the attenuation by
4.4 dB on a downlink transmission evaluated at the UE, on its CQI evaluated
at the base station, and on an uplink transmission evaluated at the base
station; the base station's own deviate counts for none of them.

The UE's indoor distance is the UE end's in the same way. With PL_in = 0.5 d2D-in
(Table 7.4.3-2), raising the UE's distance from 7 to 17 m raises the attenuation of
each of the three links by 5 dB, and the base station's own distance, 13 m, counts
for none of them.

The high-loss model is the choice of the channel model the link is evaluated by,
which is the base station's for a UE's uplink frame and its DL CQI. A channel
model with useBuildingPenetrationHighLossModel on, at an outdoor base station,
evaluating an indoor UE: sigma_P is 6.5 dB per unit of deviate (Table 7.4.3-2),
and at a deviate of 0 the attenuation exceeds the low-loss model's by the difference
of the two models' medians. At 28 GHz, whatever d2D-in, that is 20.120232142044063 dB:
t901_o2i_highloss_mean(28, d) - t901_o2i_lowloss_mean(28, d) of pathloss_reference.py.

%includes:
#include "SchedulerTestUtil.h"
#include "ChannelModelTestUtil.h"

%global:
using namespace simu5g;
using namespace simu5g::unittest;
using inet::Coord;

// The control information a packet from 'source' to 'dest' carries.
static UserControlInfo controlInfo(Direction dir, LtePhyFrameType type, MacNodeId source,
        MacNodeId dest)
{
    UserControlInfo info;
    info.setDirection(dir);
    info.setFrameType(type);
    info.setSourceId(source);
    info.setDestId(dest);
    return info;
}

%file: harness.ned
import simu5g.common.binder.Binder;
import simu5g.stack.phy.medium.CellularRadioMedium;
import simu5g.common.carrierAggregation.CarrierAggregation;
import simu5g.stack.phy.channelmodel.Tr38901ChannelModel;

network Harness
{
    submodules:
        binder: Binder;
        radioMedium: CellularRadioMedium;
        carrierAggregation: CarrierAggregation;
        bsChannelModel: Tr38901ChannelModel;
        ueChannelModel: Tr38901ChannelModel;
        bsHighLossChannelModel: Tr38901ChannelModel;
        test: Test;
}

%inifile: omnetpp.ini
[General]
network = Harness
cmdenv-express-mode = false
cmdenv-log-prefix = ""
sim-time-limit = 1s

*.carrierAggregation.numComponentCarriers = 1
*.carrierAggregation.componentCarrier[0].carrierFrequency = 28GHz
*.carrierAggregation.componentCarrier[0].numBands = 10
**.cellInfoModule = ""
*.binder.printTrafficGeneratorConfig = false

**.scenario = "URBAN_MACROCELL"
**.nodebHeight = 25m
**.ueHeight = 1.5m
**.dynamicLos = true
**.shadowing = true
**.fading = false
*.bsHighLossChannelModel.useBuildingPenetrationHighLossModel = true
**.useBuildingPenetrationHighLossModel = false

%no-default-inifile: 1

%activity:
Checker c;
auto *bs = harnessModule<StochasticChannelModel>(this, "bsChannelModel");
auto *ue = harnessModule<StochasticChannelModel>(this, "ueChannelModel");

StubEndpoint bsEndpoint, ueEndpoint;
const MacNodeId bsId = MacNodeId(1);
const MacNodeId ueId = MacNodeId(1025);
bsEndpoint.nodeId = bsId;
ueEndpoint.nodeId = ueId;
bsEndpoint.coord = Coord(0, 0, 25);
ueEndpoint.coord = Coord(120, 45, 1.5);
bsEndpoint.penetrationLossDeviate = 2.0;   // the base station's own: counts for none of the links
ueEndpoint.insideBuilding = true;
ueEndpoint.insideDistance = 7.0;
auto *medium = harnessModule<CellularRadioMedium>(this, "radioMedium");
StubRadioRegistration bsRadio(medium, bsId, &bsEndpoint);
StubRadioRegistration ueRadio(medium, ueId, &ueEndpoint);
ChannelModelProbe bsProbe(bs), ueProbe(ue);

wait(0.010);

UserControlInfo dlData = controlInfo(DL, DATAPKT, bsId, ueId);
UserControlInfo ulData = controlInfo(UL, DATAPKT, ueId, bsId);
RadioLink atUe = ueProbe.linkFor(&ueEndpoint, &dlData, bsEndpoint.coord);
RadioLink cqiAtBs = bsProbe.whatIfLink(&ueEndpoint, dlCqiTransmission(&bsEndpoint, ueId));
RadioLink ulAtBs = bsProbe.linkFor(&bsEndpoint, &ulData, ueEndpoint.coord);

// the attenuation of each link at the UE's deviate z
auto attenuations = [&] (double z) {
    ueEndpoint.penetrationLossDeviate = z;
    return std::vector<double>{ ue->getAttenuation(atUe), bs->getAttenuation(cqiAtBs), bs->getAttenuation(ulAtBs) };
};
std::vector<double> a0 = attenuations(0.0);
std::vector<double> a1 = attenuations(1.0);
c.expectNear("an indoor UE's deviate raises a downlink transmission's attenuation at the UE by sigma_P per unit", a1[0] - a0[0], 4.4, 1e-9);
c.expectNear("...that of its CQI at the base station by the same", a1[1] - a0[1], 4.4, 1e-9);
c.expectNear("...and that of its uplink transmission at the base station by the same", a1[2] - a0[2], 4.4, 1e-9);
c.check("...so the downlink and its CQI are attenuated alike", a1[0] == a1[1], std::to_string(a1[0]) + " " + std::to_string(a1[1]));

ueEndpoint.insideBuilding = false;
std::vector<double> o0 = attenuations(0.0);
std::vector<double> o1 = attenuations(1.0);
c.check("a UE outdoors has no penetration loss, whatever its deviate", o0 == o1 && o0[0] < a0[0]);

// the UE end's indoor distance
ueEndpoint.insideBuilding = true;
std::vector<double> at7m = attenuations(0.0);
ueEndpoint.insideDistance = 17.0;
std::vector<double> at17m = attenuations(0.0);
c.expectNear("an indoor UE's distance from 7 to 17 m raises a downlink transmission's attenuation at the UE by 5 dB", at17m[0] - at7m[0], 5.0, 1e-9);
c.expectNear("...that of its CQI at the base station by the same", at17m[1] - at7m[1], 5.0, 1e-9);
c.expectNear("...and that of its uplink transmission at the base station by the same", at17m[2] - at7m[2], 5.0, 1e-9);
bsEndpoint.insideDistance = 13.0;   // the base station's own: counts for none of the links
c.check("the base station's own indoor distance moves none of them", attenuations(0.0) == at17m);

// the high-loss model, of the base station's channel model
auto *bsHighLoss = harnessModule<StochasticChannelModel>(this, "bsHighLossChannelModel");
ueEndpoint.insideDistance = 7.0;
bsEndpoint.insideDistance = 0.0;
ueEndpoint.penetrationLossDeviate = 0.0;
const double cqiLow = bs->getAttenuation(cqiAtBs), ulLow = bs->getAttenuation(ulAtBs);
const double cqiHigh = bsHighLoss->getAttenuation(cqiAtBs), ulHigh = bsHighLoss->getAttenuation(ulAtBs);
c.expectNear("the high-loss model at a deviate of 0 exceeds the low-loss one by the difference of the medians, on a DL CQI", cqiHigh - cqiLow, 20.120232142044063, 1e-9);
c.expectNear("...and on an uplink frame", ulHigh - ulLow, 20.120232142044063, 1e-9);
ueEndpoint.penetrationLossDeviate = 1.0;
c.expectNear("its sigma_P is 6.5 dB per unit of deviate, on a DL CQI", bsHighLoss->getAttenuation(cqiAtBs) - cqiHigh, 6.5, 1e-9);
c.expectNear("...and on an uplink frame", bsHighLoss->getAttenuation(ulAtBs) - ulHigh, 6.5, 1e-9);

c.summary();

%contains: stdout
modelchecks=13 modelfailures=0

%not-contains: stdout
FAILED
