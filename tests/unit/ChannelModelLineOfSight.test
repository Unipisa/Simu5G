%description:

Whether a link is in line of sight: one state per link and carrier, kept by the
radio medium and shared by every channel model that evaluates the link -- both
its ends, a CQI, another cell's interference evaluation, a beacon. All of them
name the link the same way, by the node ids of its two radios, and so read the
one entry.

The first evaluation of a link draws its state, lazily, against the path-loss
strategy's LOS probability for the link's geometry; the draw is replayed from an
RngSnapshot and graded exactly. Nothing else draws it again while the UE stays
within the correlation distance, which the draw counts show: every later
evaluation, from any of those places, draws nothing, and another cell's link to
the same UE is another link with a draw of its own.

Counting draws is exact because the configuration draws nothing else: the
TR 38.901 UMi path loss draws nothing for an outdoor UE, shadowing is off, and
getAttenuation() does not evaluate fading.

%includes:
#include "SchedulerTestUtil.h"
#include "ChannelModelTestUtil.h"

%global:
using namespace simu5g;
using namespace simu5g::unittest;
using inet::Coord;

// The control information a packet from 'source' to 'dest' carries, with the
// sender's position.
static UserControlInfo controlInfo(Direction dir, LtePhyFrameType type, MacNodeId source,
        MacNodeId dest, const Coord& senderPosition)
{
    UserControlInfo info;
    info.setDirection(dir);
    info.setFrameType(type);
    info.setSourceId(source);
    info.setDestId(dest);
    info.setCoord(senderPosition);
    return info;
}

%file: harness.ned
import simu5g.common.binder.Binder;
import simu5g.stack.phy.medium.CellularRadioMedium;
import simu5g.common.carrierAggregation.CarrierAggregation;
import simu5g.stack.phy.channelmodel.Tr38901ChannelModel;

network Harness
{
    submodules:
        binder: Binder;
        radioMedium: CellularRadioMedium;
        carrierAggregation: CarrierAggregation;
        bsChannelModel: Tr38901ChannelModel;
        otherBsChannelModel: Tr38901ChannelModel;
        ueChannelModel: Tr38901ChannelModel;
        test: Test;
}

%inifile: omnetpp.ini
[General]
network = Harness
cmdenv-express-mode = false
cmdenv-log-prefix = ""
sim-time-limit = 1s
*.carrierAggregation.numComponentCarriers = 1
*.carrierAggregation.componentCarrier[0].carrierFrequency = 3.5GHz
*.carrierAggregation.componentCarrier[0].numBands = 10
**.cellInfoModule = ""
*.binder.printTrafficGeneratorConfig = false

# LOS is drawn, and nothing else is: the TR 38.901 UMi path loss draws nothing
# for an outdoor UE, and shadowing is off.
**.scenario = "URBAN_MICROCELL"
**.dynamicLos = true
**.shadowing = false

%no-default-inifile: 1

%activity:
Checker c;
auto *bs = harnessModule<StochasticChannelModel>(this, "bsChannelModel");
auto *otherBs = harnessModule<StochasticChannelModel>(this, "otherBsChannelModel");
auto *ueModel = harnessModule<StochasticChannelModel>(this, "ueChannelModel");

StubEndpoint enb, otherEnb, ue;
enb.nodeId = MacNodeId(1);
enb.coord = Coord(0, 0, 10);
otherEnb.nodeId = MacNodeId(2);
otherEnb.coord = Coord(400, 0, 10);
ue.nodeId = MacNodeId(1025);
ue.coord = Coord(60, 30, 1.5);
bs->setPhy(&enb);
otherBs->setPhy(&otherEnb);
ueModel->setPhy(&ue);
ChannelModelProbe atEnb(bs), atOther(otherBs), atUe(ueModel);

auto drawn = [](StochasticChannelModel *model) { return (long long)model->getRNG(0)->getNumbersDrawn(); };

const LinkKey link1(MacNodeId(1), MacNodeId(1025)), link2(MacNodeId(2), MacNodeId(1025));

{
    // The first evaluation of a link draws its state.
    UserControlInfo info = controlInfo(DL, DATAPKT, MacNodeId(1), MacNodeId(1025), enb.coord);
    const double d3D = enb.coord.distance(ue.coord);
    const double d2D = sqrt(pow(ue.coord.x - enb.coord.x, 2) + pow(ue.coord.y - enb.coord.y, 2));
    double p = atUe.pathLoss()->computeLosProbability(d3D, d2D);
    RngSnapshot snapshot(ueModel);
    long long before = drawn(ueModel);
    ueModel->getAttenuation(atUe.linkFor(&info));
    bool expected = omnetpp::uniform(snapshot.rng(), 0.0, 1.0) <= p;
    c.check("a link's first evaluation draws its LOS state against the strategy's LOS probability",
            atUe.losMap().count(link1) == 1 && atUe.losMap().at(link1) == expected,
            "p=" + std::to_string(p));
    c.expectValue("...one draw, and nothing else", drawn(ueModel) - before, 1);
}
c.check("every channel model on the carrier reads the same map, the medium's",
        &atEnb.losMap() == &atUe.losMap() && &atOther.losMap() == &atUe.losMap());

const bool los1 = atUe.losMap().at(link1);
{
    // The other end of the link.
    UserControlInfo info = controlInfo(UL, DATAPKT, MacNodeId(1025), MacNodeId(1), ue.coord);
    long long before = drawn(bs);
    bs->getAttenuation(atEnb.linkFor(&info));
    c.expectValue("the other end of the link reads the same state and draws nothing", drawn(bs) - before, 0);
}
{
    UserControlInfo info = controlInfo(DL, FEEDBACKPKT, MacNodeId(1025), MacNodeId(1), ue.coord);
    long long before = drawn(bs);
    bs->getAttenuation(atEnb.linkFor(&info));
    c.expectValue("a DL CQI at the base station is the same link: no draw", drawn(bs) - before, 0);
}
{
    // Another cell's link to the same UE.
    UserControlInfo info = controlInfo(DL, DATAPKT, MacNodeId(2), MacNodeId(1025), otherEnb.coord);
    long long before = drawn(ueModel);
    ueModel->getAttenuation(atUe.linkFor(&info));
    c.expectValue("another cell's link to the same UE is another link, drawn on its own",
            drawn(ueModel) - before, 1);
    c.check("...and the first link's state is untouched",
            atUe.losMap().count(link2) == 1 && atUe.losMap().at(link1) == los1);
}
{
    // What the interference computation evaluates.
    long long before = drawn(otherBs);
    otherBs->getAttenuation(atOther.cellularLink(MacNodeId(1025), UL, ue.coord, false));
    c.expectValue("the other cell evaluating its link to the UE, as for interference, reads that state: no draw",
            drawn(otherBs) - before, 0);
}
{
    UserControlInfo info = controlInfo(DL, BEACONPKT, MacNodeId(1), NODEID_NONE, enb.coord);
    long long before = drawn(ueModel);
    ueModel->getAttenuation(atUe.linkFor(&info));
    c.expectValue("a beacon is evaluated on the link between its sender and the receiver: no draw",
            drawn(ueModel) - before, 0);
}
c.expectValue("...and the carrier holds exactly the two links", (long long)atUe.losMap().size(), 2);

c.summary();

%contains: stdout
modelchecks=10 modelfailures=0

%not-contains: stdout
FAILED
