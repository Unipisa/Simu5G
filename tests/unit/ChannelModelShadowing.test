%description:

StochasticChannelModel::computeShadowing(): the log-normal shadowing of a link
and how it evolves -- the second of the two stateful mechanisms a refactoring
of the medium has to move, after Jakes fading.

The model keeps one shadowing value per link and updates it with a first-order
recurrence the specification does not give but the model states: once either
end of the link is farther than the correlation distance from where the last
sample was drawn,

    att = a * old + sqrt(1 - a^2) * N(0, sigma),   a = exp(-0.5 * space / dcorr)

and at or below that distance the previous value is returned unchanged. The draws
are replayed from an RngSnapshot, so the recurrence is graded exactly rather
than statistically, including the strict inequality at the boundary.

Both the 0.5 and the hold below dcorr are a known deviation, pinned here as a
defect and not endorsed: TR 38.901 7.4.4 gives the autocorrelation
R(dx) = exp(-dx/d_cor), which the recurrence realizes only with
a = exp(-dx/d_cor) at every displacement. ChannelModelShadowingCorrelation
asserts the specification as an expected failure. The pins are here so that
any change to the model's update fails by name; when the model follows the
specification, change them together with that test.

Distance here is displacement, not distance travelled, and time plays no part: a
UE that goes out and comes back keeps its sample, and one that jumps past the
correlation distance is redrawn at once. Both ends of the link count, the
farther-moved one deciding, so a D2D link's sample is the same whichever of its
UEs transmits; for a cellular link, whose base station stays put, it is how far
the UE has moved.

sigma is not the model's to choose: it comes from the path-loss strategy's
getShadowingStdDev() for the link's LOS state, which PathLossShadowing grades
against the 3GPP tables. Asserting the delegation here is what keeps that
test covering the value this one uses. The caller passes that state in: whether
a link is in line of sight is decided once per link, not by the shadowing.

Per-link keying is checked because it is the whole point of LinkKey: two links
of the same node are two independent realizations, not one shared value. The
shadowing of a link is one realization, kept once per link and read by
whichever end evaluates it: a DL CQI computed at the base station assumes
exactly the shadowing the UE then decodes through. And getAttenuation() adds no shadowing at all for a background UE, whose id is at
or above BGUE_MIN_ID.

%includes:
#include "SchedulerTestUtil.h"
#include "ChannelModelTestUtil.h"

%global:
using namespace simu5g;
using namespace simu5g::unittest;

// The control information a packet from 'source' to 'dest' carries, with the
// sender's position.
static UserControlInfo controlInfo(Direction dir, LtePhyFrameType type, MacNodeId source,
        MacNodeId dest, const inet::Coord& senderPosition)
{
    UserControlInfo info;
    info.setDirection(dir);
    info.setFrameType(type);
    info.setSourceId(source);
    info.setDestId(dest);
    info.setCoord(senderPosition);
    return info;
}

// The same link geometry for every radio link built here.
static RadioLink linkTo(MacNodeId node, const inet::Coord& bs, const inet::Coord& ueCoord)
{
    RadioLink link;
    link.dir = DL;
    link.txId = MacNodeId(1);
    link.rxId = node;
    link.txCoord = bs;
    link.rxCoord = ueCoord;
    link.linkKey = LinkKey(MacNodeId(1), node);
    link.stateNodeId = node;
    link.txIsBaseStation = true;
    return link;
}

// The link between two UEs, from 'tx' to 'rx'.
static RadioLink d2dLinkBetween(MacNodeId tx, const inet::Coord& txCoord, MacNodeId rx, const inet::Coord& rxCoord)
{
    RadioLink link;
    link.dir = D2D;
    link.txId = tx;
    link.rxId = rx;
    link.txCoord = txCoord;
    link.rxCoord = rxCoord;
    link.linkKey = LinkKey(tx, rx);
    link.stateNodeId = tx;
    link.txIsBaseStation = false;
    return link;
}

%file: harness.ned
import simu5g.common.binder.Binder;
import simu5g.stack.phy.medium.CellularRadioMedium;
import simu5g.common.carrierAggregation.CarrierAggregation;
import simu5g.stack.phy.channelmodel.Tr38901ChannelModel;

network Harness
{
    submodules:
        binder: Binder;
        radioMedium: CellularRadioMedium;
        carrierAggregation: CarrierAggregation;
        bsChannelModel: Tr38901ChannelModel;
        ueChannelModel: Tr38901ChannelModel;
        test: Test;
}

%inifile: omnetpp.ini
[General]
network = Harness
cmdenv-express-mode = false
cmdenv-log-prefix = ""
sim-time-limit = 100s

*.carrierAggregation.numComponentCarriers = 1
*.carrierAggregation.componentCarrier[0].carrierFrequency = 3.5GHz
*.carrierAggregation.componentCarrier[0].numBands = 10
**.cellInfoModule = ""
*.binder.printTrafficGeneratorConfig = false

# Stated rather than inherited. The LOS state is fixed, so that getAttenuation()
# draws nothing but the shadowing this test is about.
**.scenario = "URBAN_MACROCELL"
**.shadowing = true
**.correlationDistance = 50m
**.dynamicLos = false
**.fixedLos = true

%no-default-inifile: 1

%activity:
Checker c;
auto *bs = harnessModule<StochasticChannelModel>(this, "bsChannelModel");
auto *ue = harnessModule<StochasticChannelModel>(this, "ueChannelModel");

const MacNodeId ueId = MacNodeId(1025);
StubEndpoint bsEndpoint, ueEndpoint;
bsEndpoint.nodeId = MacNodeId(1);
ueEndpoint.nodeId = ueId;
bsEndpoint.coord = inet::Coord(0, 0, 25);
ueEndpoint.coord = inet::Coord(200, 0, 1.5);
ueEndpoint.channelModels[ue->getCarrierFrequency()] = ue;

ChannelModelProbe bsProbe(bs), ueProbe(ue);
PathLossModel *pathLoss = bsProbe.pathLoss();
const double dcorr = bs->par("correlationDistance").doubleValue();
const double d3D = 200.0, d2D = 198.6;
const inet::Coord bsPos(0, 0, 25);

//
// --- the first value, and where sigma comes from ---
//
{
    // Two fresh links, one in LOS and one not: each first value is one normal
    // draw with the strategy's sigma for that state.
    const LinkKey losKey(MacNodeId(1), MacNodeId(1100));
    const inet::Coord uePos(200, 0, 1.5);
    const RadioLink losLink = linkTo(MacNodeId(1100), bsPos, uePos);
    const RadioLink nlosLink = linkTo(MacNodeId(1101), bsPos, uePos);
    double sigmaLos = pathLoss->getShadowingStdDev(d3D, d2D, true);
    double sigmaNlos = pathLoss->getShadowingStdDev(d3D, d2D, false);
    c.check("the strategy's sigma differs between LOS and NLOS here, so the next checks discriminate",
            sigmaLos != sigmaNlos,
            "LOS=" + std::to_string(sigmaLos) + " NLOS=" + std::to_string(sigmaNlos));

    RngSnapshot snapshot(bs);
    double gotLos = bs->computeShadowing(d3D, d2D, true, losLink);
    double gotNlos = bs->computeShadowing(d3D, d2D, false, nlosLink);
    c.expectNear("a link's first shadowing value is N(0, sigma), sigma from the strategy for LOS",
            gotLos, omnetpp::normal(snapshot.rng(), 0, sigmaLos), 0);
    c.expectNear("...and for NLOS", gotNlos, omnetpp::normal(snapshot.rng(), 0, sigmaNlos), 0);
    const auto& sample = bsProbe.shadowingMap().at(losKey);
    c.check("...and it is stored, stamped with when and where it was drawn",
            sample.time == simTime() && sample.value == gotLos
            && sample.positionA == bsPos && sample.positionB == uePos);
}

//
// --- how it evolves ---
//
{
    // A stationary UE never moves past the correlation distance, so its
    // shadowing is a constant offset for the whole run.
    const RadioLink link = linkTo(MacNodeId(1102), bsPos, inet::Coord(200, 0, 1.5));
    double first = bs->computeShadowing(d3D, d2D, false, link);
    unsigned long drawn = bs->getRNG(0)->getNumbersDrawn();
    bool constant = true;
    for (int i = 0; i < 5; i++) {
        wait(7.0);
        if (bs->computeShadowing(d3D, d2D, false, link) != first)
            constant = false;
    }
    c.check("a stationary UE keeps its shadowing for the whole run", constant);
    c.expectValue("...and draws nothing to keep it",
            (long long)(bs->getRNG(0)->getNumbersDrawn() - drawn), 0);
}
{
    // Moving, but not yet past the correlation distance from where the sample
    // was drawn: held. Exactly at it: still held, the inequality is strict.
    const MacNodeId node = MacNodeId(1103);
    const LinkKey key(MacNodeId(1), node);
    double first = bs->computeShadowing(d3D, d2D, false, linkTo(node, bsPos, inet::Coord(200, 0, 1.5)));
    double within = bs->computeShadowing(d3D, d2D, false, linkTo(node, bsPos, inet::Coord(220, 0, 1.5)));
    double atBoundary = bs->computeShadowing(d3D, d2D, false, linkTo(node, bsPos, inet::Coord(250, 0, 1.5)));
    c.check("PINNED DEFECT: below the correlation distance the value is held", within == first);
    c.check("PINNED DEFECT: exactly at the correlation distance it is still held (the test is strict)",
            atBoundary == first, "dcorr=" + std::to_string(dcorr));

    // Past it: the recurrence, graded from the replayed draw.
    double old = bsProbe.shadowingMap().at(key).value;
    double sigma = pathLoss->getShadowingStdDev(d3D, d2D, false);
    RngSnapshot snapshot(bs);
    double updated = bs->computeShadowing(d3D, d2D, false, linkTo(node, bsPos, inet::Coord(260, 0, 1.5)));
    double space = 60.0;
    double a = exp(-0.5 * (space / dcorr));
    double expected = a * old + sqrt(1 - pow(a, 2)) * omnetpp::normal(snapshot.rng(), 0, sigma);
    c.expectNear("PINNED DEFECT: past it, att = a*old + sqrt(1-a^2)*N(0,sigma), a = exp(-0.5*space/dcorr), space the distance moved",
            updated, expected, 0);
    const auto& sample = bsProbe.shadowingMap().at(key);
    c.check("...and the new sample records where and when it was drawn",
            sample.positionB == inet::Coord(260, 0, 1.5) && sample.time == simTime());
}

//
// --- displacement, not distance travelled ---
//
{
    const MacNodeId node = MacNodeId(1107);
    const LinkKey key(MacNodeId(1), node);
    double first = bs->computeShadowing(d3D, d2D, false, linkTo(node, bsPos, inet::Coord(200, 0, 1.5)));
    unsigned long drawn = bs->getRNG(0)->getNumbersDrawn();
    double out = bs->computeShadowing(d3D, d2D, false, linkTo(node, bsPos, inet::Coord(240, 0, 1.5)));
    double back = bs->computeShadowing(d3D, d2D, false, linkTo(node, bsPos, inet::Coord(210, 0, 1.5)));
    c.check("PINNED DEFECT: a UE that goes out and comes back keeps its sample: what counts is how far it is from "
            "where the sample was drawn, not how far it went",
            out == first && back == first
            && bs->getRNG(0)->getNumbersDrawn() == drawn);

    // No time passes: the jump is graded like any other update.
    double sigma = pathLoss->getShadowingStdDev(d3D, d2D, false);
    RngSnapshot snapshot(bs);
    double jumped = bs->computeShadowing(d3D, d2D, false, linkTo(node, bsPos, inet::Coord(300, 0, 1.5)));
    double space = 100.0;
    double a = exp(-0.5 * (space / dcorr));
    double expected = a * first + sqrt(1 - pow(a, 2)) * omnetpp::normal(snapshot.rng(), 0, sigma);
    c.expectNear("PINNED DEFECT: ...and the time it took does not matter: a jump past the correlation distance redraws at once",
            jumped, expected, 0);
}

//
// --- both ends of a link count ---
//
{
    const MacNodeId tx = MacNodeId(1110), rx = MacNodeId(1111);
    const LinkKey key(tx, rx);
    const inet::Coord txPos(500, 0, 1.5), rxPos(520, 0, 1.5), rxMoved(580, 0, 1.5);
    double first = bs->computeShadowing(d3D, d2D, false, d2dLinkBetween(tx, txPos, rx, rxPos));

    // Only the receiver moves.
    double sigma = pathLoss->getShadowingStdDev(d3D, d2D, false);
    RngSnapshot snapshot(bs);
    double updated = bs->computeShadowing(d3D, d2D, false, d2dLinkBetween(tx, txPos, rx, rxMoved));
    double space = 60.0;
    double a = exp(-0.5 * (space / dcorr));
    double expected = a * first + sqrt(1 - pow(a, 2)) * omnetpp::normal(snapshot.rng(), 0, sigma);
    c.check("a link's sample is redrawn when either end has moved past the correlation distance -- here the receiver",
            updated != first);
    c.expectNear("PINNED DEFECT: ...as the recurrence, with the distance the receiver moved", updated, expected, 0);

    // The other direction, at the same positions.
    unsigned long drawn = bs->getRNG(0)->getNumbersDrawn();
    double reverse = bs->computeShadowing(d3D, d2D, false, d2dLinkBetween(rx, rxMoved, tx, txPos));
    c.check("...and it is the same sample whichever end transmits: the other direction, at the same positions, holds it",
            reverse == updated && bs->getRNG(0)->getNumbersDrawn() == drawn
            && bsProbe.shadowingMap().count(key) == 1);
}
{
    // Both ends move past the correlation distance, by 60 m and 80 m: the
    // farther-moved end decides, so the recurrence takes space = 80 m (not the
    // nearer end's 60 m, their sum of 140 m or the 100 m of their norm).
    const MacNodeId tx = MacNodeId(1112), rx = MacNodeId(1113);
    const inet::Coord txPos(500, 100, 1.5), rxPos(520, 100, 1.5);
    const inet::Coord txMoved(440, 100, 1.5), rxMoved(600, 100, 1.5);
    double first = bs->computeShadowing(d3D, d2D, false, d2dLinkBetween(tx, txPos, rx, rxPos));
    double sigma = pathLoss->getShadowingStdDev(d3D, d2D, false);
    RngSnapshot snapshot(bs);
    double updated = bs->computeShadowing(d3D, d2D, false, d2dLinkBetween(tx, txMoved, rx, rxMoved));
    double a = exp(-0.5 * (80.0 / dcorr));
    double expected = a * first + sqrt(1 - pow(a, 2)) * omnetpp::normal(snapshot.rng(), 0, sigma);
    c.expectNear("PINNED DEFECT: when both ends have moved, the farther-moved one decides: the recurrence takes its 80 m",
            updated, expected, 0);
}

//
// --- whose value: per link, seen from either end ---
//
{
    // Two links of one node are two independent realizations.
    const MacNodeId owner = MacNodeId(1104), peerA = MacNodeId(1105), peerB = MacNodeId(1106);
    const inet::Coord ownerPos(700, 0, 1.5);
    double sigma = pathLoss->getShadowingStdDev(d3D, d2D, false);
    RngSnapshot snapshot(bs);
    double a = bs->computeShadowing(d3D, d2D, false, d2dLinkBetween(owner, ownerPos, peerA, inet::Coord(720, 0, 1.5)));
    double b = bs->computeShadowing(d3D, d2D, false, d2dLinkBetween(owner, ownerPos, peerB, inet::Coord(740, 0, 1.5)));
    c.check("two links of one node get two entries", bsProbe.shadowingMap().count(LinkKey(owner, peerA)) == 1
            && bsProbe.shadowingMap().count(LinkKey(owner, peerB)) == 1);
    c.check("...each its own draw",
            a == omnetpp::normal(snapshot.rng(), 0, sigma) && b == omnetpp::normal(snapshot.rng(), 0, sigma));
    c.check("...so the two differ", a != b);
}
{
    // A DL CQI at the base station and the UE's decoding are the same link,
    // evaluated from its two ends, at the same geometry and LOS state.
    UserControlInfo data = controlInfo(DL, DATAPKT, MacNodeId(1), ueId, bsEndpoint.coord);
    double cqiView = bs->getAttenuation(bsProbe.whatIfLink(&ueEndpoint, dlCqiTransmission(&bsEndpoint, ueId)));

    // The path loss may draw on its own account (see the background UE below),
    // so "draws nothing" is measured against an identical evaluation at once.
    unsigned long before = ue->getRNG(0)->getNumbersDrawn();
    double decoderView = ue->getAttenuation(ueProbe.linkFor(&ueEndpoint, &data));
    long long decoderDraws = ue->getRNG(0)->getNumbersDrawn() - before;
    before = ue->getRNG(0)->getNumbersDrawn();
    ue->getAttenuation(ueProbe.linkFor(&ueEndpoint, &data));
    long long pathLossDraws = ue->getRNG(0)->getNumbersDrawn() - before;

    c.check("every channel model on the carrier reads the same shadowing map, the medium's",
            &bsProbe.shadowingMap() == &ueProbe.shadowingMap());
    c.check("a DL CQI and the UE decoding are one link, with one shadowing entry",
            bsProbe.shadowingMap().count(LinkKey(MacNodeId(1), ueId)) == 1);
    c.check("...so the shadowing a DL CQI assumes is the shadowing the UE decodes through",
            cqiView == decoderView);
    c.expectValue("...and the UE's evaluation draws nothing for it", decoderDraws, pathLossDraws);
}

//
// --- background UEs get none ---
//
{
    // At the same geometry and LOS state, a regular UE's attenuation exceeds a
    // background UE's by exactly the regular UE's shadowing.
    const inet::Coord bsCoord(0, 0, 25), ueCoord(200, 0, 1.5);
    const MacNodeId regular = MacNodeId(1108), background = MacNodeId(BGUE_MIN_ID + 7);
    double attRegular = bs->getAttenuation(linkTo(regular, bsCoord, ueCoord));

    // The path loss may draw on its own account -- the TR 38.901 UMa formula
    // draws for the environment height h_E on every evaluation, even when the
    // outcome is certain -- so "draws nothing" is measured against it: evaluated
    // again at once, the regular UE's shadowing is held, and what it draws is
    // the path loss's alone.
    unsigned long before = bs->getRNG(0)->getNumbersDrawn();
    bs->getAttenuation(linkTo(regular, bsCoord, ueCoord));
    long long pathLossDraws = bs->getRNG(0)->getNumbersDrawn() - before;
    before = bs->getRNG(0)->getNumbersDrawn();
    double attBackground = bs->getAttenuation(linkTo(background, bsCoord, ueCoord));
    long long backgroundDraws = bs->getRNG(0)->getNumbersDrawn() - before;

    c.expectNear("a background UE's attenuation lacks exactly the shadowing a regular UE's has",
            attRegular - attBackground, bsProbe.shadowingMap().at(LinkKey(MacNodeId(1), regular)).value, 1e-9);
    c.check("...no shadowing is kept for it", bsProbe.shadowingMap().count(LinkKey(MacNodeId(1), background)) == 0);
    c.expectValue("...and it draws only what the path loss itself draws", backgroundDraws, pathLossDraws);
}

c.summary();

%contains: stdout
modelchecks=26 modelfailures=0

%not-contains: stdout
FAILED
