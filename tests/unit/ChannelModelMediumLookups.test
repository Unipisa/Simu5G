%description:

What a channel model looks up about other nodes' radios through the radio
medium's registry, checked with stub radios registered there -- the
lookups that went through the node's module path before and so could not be
given a stub.

getRSRP(): the link budget and the angular attenuation are the two radios',
found in the medium by the link's transmitter and receiver ids. A transmitter
or receiver antenna gain adds exactly its value, and the receiver's cable
loss subtracts exactly its value, on every band. An omnidirectional base
station adds no angular term; a sectorial one subtracts exactly
computeAngularAttenuation() of the receiver's angles, on every band. A link
whose transmitter is not on the medium cannot be evaluated.

emitRcvdSinr(): the statistic is the UE's, and its receiver records it. A
downlink SINR is emitted on the receiving UE's own receiver; an uplink SINR is
emitted, from the base station's model, on the sending UE's receiver, found
through the medium. Neither reaches the base station's receiver. A receiver
serving two carriers also emits the value on that carrier's own signal.

%includes:
#include "SchedulerTestUtil.h"
#include "ChannelModelTestUtil.h"

%global:
using namespace simu5g;
using namespace simu5g::unittest;
using inet::Coord;

static UserControlInfo downlinkData(MacNodeId enb, MacNodeId ue, const Coord& enbPosition)
{
    UserControlInfo info;
    info.setDirection(DL);
    info.setFrameType(DATAPKT);
    info.setSourceId(enb);
    info.setDestId(ue);
    info.setCoord(enbPosition);
    return info;
}

// Remembers the last value each component emitted on the signals it is subscribed to.
class LastValues : public cListener
{
  public:
    std::map<std::pair<const cComponent *, simsignal_t>, double> values;
    virtual void receiveSignal(cComponent *source, simsignal_t signal, double value, cObject *) override
    {
        values[{source, signal}] = value;
    }
    bool has(const cComponent *source, simsignal_t signal) const { return values.count({source, signal}) != 0; }
    double get(const cComponent *source, simsignal_t signal) const { return values.at({source, signal}); }
};

%file: harness.ned
import simu5g.common.binder.Binder;
import simu5g.stack.phy.medium.CellularRadioMedium;
import simu5g.common.carrierAggregation.CarrierAggregation;
import simu5g.stack.phy.channelmodel.Tr38901ChannelModel;
import simu5g.stack.phy.radio.CellularReceiver;

network Harness
{
    submodules:
        binder: Binder;
        radioMedium: CellularRadioMedium;
        carrierAggregation: CarrierAggregation;
        bsChannelModel: Tr38901ChannelModel;
        ueChannelModel: Tr38901ChannelModel;
        bsReceiver: CellularReceiver;
        ueReceiver: CellularReceiver;
        test: Test;
}

%inifile: omnetpp.ini
[General]
network = Harness
cmdenv-express-mode = false
cmdenv-log-prefix = ""
sim-time-limit = 1s
*.carrierAggregation.numComponentCarriers = 1
*.carrierAggregation.componentCarrier[0].carrierFrequency = 3.5GHz
*.carrierAggregation.componentCarrier[0].numBands = 10
**.cellInfoModule = ""
*.binder.printTrafficGeneratorConfig = false

# Path loss only: no shadowing or fading, so repeated evaluations of a link agree.
**.shadowing = false
**.fading = false

%no-default-inifile: 1

%activity:
Checker c;
auto *bs = harnessModule<StochasticChannelModel>(this, "bsChannelModel");
auto *ue = harnessModule<StochasticChannelModel>(this, "ueChannelModel");
auto *medium = harnessModule<CellularRadioMedium>(this, "radioMedium");
auto *bsReceiver = harnessModule<CellularReceiver>(this, "bsReceiver");
auto *ueReceiver = harnessModule<CellularReceiver>(this, "ueReceiver");

const MacNodeId enbId = MacNodeId(1), otherEnbId = MacNodeId(2), ueId = MacNodeId(1025);
const Coord enbPos(0, 0, 25), uePos(120, 45, 1.5);
StubEndpoint enbEndpoint, ueEndpoint;
enbEndpoint.coord = enbPos;
ueEndpoint.coord = uePos;
ueEndpoint.channelModels[ue->getCarrierFrequency()] = ue;
enbEndpoint.receiver = bsReceiver;
ueEndpoint.receiver = ueReceiver;
bs->setPhy(&enbEndpoint);
ue->setPhy(&ueEndpoint);
StubRadioRegistration enbRadio(medium, enbId, &enbEndpoint);
StubRadioRegistration ueRadio(medium, ueId, &ueEndpoint);
ChannelModelProbe atEnb(bs), atUe(ue);

c.check("a registered radio is the one the medium finds", medium->findRadio(enbId) == &enbEndpoint);
c.check("...and a node with no radio on the medium finds none", medium->findRadio(otherEnbId) == nullptr);

//
// --- getRSRP(): the transmitting base station's antenna ---
//
{
    const double txPower = 40; // dBm
    UserControlInfo fromEnb = downlinkData(enbId, ueId, enbPos);
    RadioLink link = atUe.linkFor(&fromEnb);

    enbEndpoint.txDirection = OMNI;
    std::vector<double> omni = ue->getRSRP(link, txPower);

    enbEndpoint.txDirection = ANISOTROPIC;
    enbEndpoint.txAngle = 0;
    std::vector<double> sector = ue->getRSRP(link, txPower);

    double recvAngle = fabs(0 - ue->computeAngle(enbPos, uePos));
    if (recvAngle > 180)
        recvAngle = 360 - recvAngle;
    double expected = ue->computeAngularAttenuation(recvAngle, ue->computeVerticalAngle(enbPos, uePos));
    bool everyBand = omni.size() == sector.size() && !omni.empty();
    for (size_t band = 0; everyBand && band < omni.size(); band++)
        if (fabs((omni[band] - sector[band]) - expected) > 1e-9)
            everyBand = false;
    c.check("a sectorial base station's antenna attenuates the downlink by the pattern at the UE's angles, on every band",
            everyBand && expected > 0, "expected " + std::to_string(expected) + " dB");

    // The link budget: each term shifts every band by exactly its value.
    enbEndpoint.txDirection = OMNI;
    auto shiftedBy = [&] (double delta) {
        std::vector<double> rsrp = ue->getRSRP(link, txPower);
        bool exact = rsrp.size() == omni.size();
        for (size_t band = 0; exact && band < rsrp.size(); band++)
            exact = fabs((rsrp[band] - omni[band]) - delta) < 1e-9;
        return exact;
    };
    enbEndpoint.antennaGain = 3;
    c.check("the transmitter's antenna gain is added, on every band", shiftedBy(3));
    enbEndpoint.antennaGain = 0;
    ueEndpoint.antennaGain = 2;
    c.check("...and the receiver's", shiftedBy(2));
    ueEndpoint.antennaGain = 0;
    ueEndpoint.cableLoss = 1;
    c.check("...and the receiver's cable loss subtracted", shiftedBy(-1));
    ueEndpoint.cableLoss = 0;

    // The same geometry from a base station that has no radio on the medium.
    UserControlInfo fromOther = downlinkData(otherEnbId, ueId, enbPos);
    RadioLink otherLink = atUe.linkFor(&fromOther);
    c.expectRejected("a link whose transmitter is not on the medium is rejected", [&] {
        ue->getRSRP(otherLink, txPower);
    });
}

//
// --- emitRcvdSinr(): whose statistic ---
//
{
    simsignal_t dl = cComponent::registerSignal("rcvdSinrDl"), ul = cComponent::registerSignal("rcvdSinrUl");
    LastValues seen;
    for (cComponent *component : {(cComponent *)bs, (cComponent *)ue, (cComponent *)bsReceiver, (cComponent *)ueReceiver})
        for (simsignal_t signal : {dl, ul})
            component->subscribe(signal, &seen);

    atEnb.emitRcvdSinr(UL, ueId, ue->getCarrierFrequency(), 12.5);
    c.check("an uplink SINR is emitted on the sending UE's receiver",
            seen.has(ueReceiver, ul) && seen.get(ueReceiver, ul) == 12.5);
    c.check("...not on the base station's, nor on either channel model",
            !seen.has(bsReceiver, ul) && !seen.has(bs, ul) && !seen.has(ue, ul));

    atUe.emitRcvdSinr(DL, ueId, ue->getCarrierFrequency(), 7.0);
    c.check("a downlink SINR is emitted on the receiving UE's receiver",
            seen.has(ueReceiver, dl) && seen.get(ueReceiver, dl) == 7.0
            && !seen.has(bsReceiver, dl) && !seen.has(ue, dl));

    // The same receiver serving a second carrier: the value also goes to the
    // carrier's own signal, named by its frequency in MHz.
    ueReceiver->setCarrierFrequencies({ue->getCarrierFrequency(), GHz(28)});
    simsignal_t ulOnCarrier = cComponent::registerSignal("rcvdSinrUl-3500MHz");
    ueReceiver->subscribe(ulOnCarrier, &seen);
    atEnb.emitRcvdSinr(UL, ueId, ue->getCarrierFrequency(), 9.5);
    c.check("with two carriers, an uplink SINR is also emitted on its carrier's own signal",
            seen.has(ueReceiver, ul) && seen.get(ueReceiver, ul) == 9.5
            && seen.has(ueReceiver, ulOnCarrier) && seen.get(ueReceiver, ulOnCarrier) == 9.5);
    ueReceiver->unsubscribe(ulOnCarrier, &seen);

    for (cComponent *component : {(cComponent *)bs, (cComponent *)ue, (cComponent *)bsReceiver, (cComponent *)ueReceiver})
        for (simsignal_t signal : {dl, ul})
            component->unsubscribe(signal, &seen);
}

c.summary();

%contains: stdout
modelchecks=11 modelfailures=0

%not-contains: stdout
FAILED
