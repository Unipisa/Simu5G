%description:

Path loss of Tr38901PathLossModel, checked against 3GPP TR 38.901 v16.1.0,
Table 7.4.1-1, for the InH, UMi-Street Canyon, UMa and RMa deployment
scenarios.

Path loss is a function of the 3D distance, while the breakpoint comparison
and the validity ranges are functions of the 2D distance, so both are passed
independently below. The breakpoint distance uses the c = 3.0e8 m/s the
specification prescribes.

Each case names the formula of pathloss_reference.py it is to be graded
against; the formulas themselves are quoted there.

%includes:
#include "PathLossTestUtil.h"
#include "simu5g/stack/phy/channelmodel/Tr38901PathLossModel.h"

%global:
using namespace simu5g;
using namespace simu5g::unittest;

%activity:
CaseRecorder probe(this, 1e-6);
Tr38901PathLossModel m;
ScenarioParams p;

// --- InH, fc = 3.5 GHz ------------------------------------------------
p = ScenarioParams();
p.scenario = INDOOR_HOTSPOT;
p.hNodeB = 3;
p.hUe = 1.5;
p.carrierFrequencyGHz = 3.5;

probe.pathLoss("t901_inh_los",  m, p, 5, 5, true);
probe.pathLoss("t901_inh_los",  m, p, 30, 30, true);
probe.pathLoss("t901_inh_los",  m, p, 100, 100, true);
probe.pathLoss("t901_inh_nlos", m, p, 5, 5, false);
probe.pathLoss("t901_inh_nlos", m, p, 30, 30, false);
probe.pathLoss("t901_inh_nlos", m, p, 100, 100, false);

// Below 1 m the 3D distance is clamped to 1 m, where the report's own
// formula takes over, so the case is graded at 1 m rather than at 0.5 m.
p.apply(m, this);
probe.record("t901_inh_los", p, { { "d3D", 1.0 } }, m.computePathLoss(0.5, 0.5, true, {}));

probe.expectRejected("InH d3D=200 rejected", [&]() { m.computePathLoss(200, 200, true, {}); });

// --- UMi-Street Canyon, hBS = 10 m, hUT = 1.5 m, fc = 3.5 GHz ---------
// hE = 1 m, so dBP = 4 (hBS-1)(hUT-1) fc/c = 210.000 m.
p = ScenarioParams();
p.scenario = URBAN_MICROCELL;
p.hNodeB = 10;
p.hUe = 1.5;
p.carrierFrequencyGHz = 3.5;

probe.pathLoss("t901_umi_los",  m, p, 21.5, 20, true);         // below dBP
probe.pathLoss("t901_umi_los",  m, p, 100.36, 100, true);      // below dBP
probe.pathLoss("t901_umi_los",  m, p, 1000.04, 1000, true);    // above dBP
probe.pathLoss("t901_umi_nlos", m, p, 21.5, 20, false);
probe.pathLoss("t901_umi_nlos", m, p, 100.36, 100, false);
probe.pathLoss("t901_umi_nlos", m, p, 1000.04, 1000, false);

probe.expectRejected("UMi d2D=6000 rejected", [&]() { m.computePathLoss(6000, 6000, true, {}); });

// --- UMa, hBS = 25 m, hUT = 1.5 m, fc = 2 GHz -------------------------
// hE = 1 m with probability 1/(1 + C(d2D, hUT)); C = 0 for hUT < 13 m, so
// hE = 1 m and dBP = 4 (hBS-1)(hUT-1) fc/c = 320.000 m here.
p = ScenarioParams();
p.scenario = URBAN_MACROCELL;
p.hNodeB = 25;
p.hUe = 1.5;
p.carrierFrequencyGHz = 2.0;

probe.pathLoss("t901_uma_los",  m, p, 55.9, 50, true);         // below dBP
probe.pathLoss("t901_uma_los",  m, p, 102.7, 100, true);       // below dBP
probe.pathLoss("t901_uma_los",  m, p, 1000.28, 1000, true);    // above dBP
probe.pathLoss("t901_uma_nlos", m, p, 102.7, 100, false);
probe.pathLoss("t901_uma_nlos", m, p, 1000.28, 1000, false);

probe.expectRejected("UMa d2D=6000 rejected", [&]() { m.computePathLoss(6000, 6000, true, {}); });

// --- RMa, hBS = 35 m, hUT = 1.5 m, fc = 0.8 GHz -----------------------
// dBP = 2 pi hBS hUT fc/c = 879.646 m. TR 38.901 fixes the average building
// height at 5 m and the average street width at 20 m for RMa, so the model
// ignores its own hBuilding and wStreet parameters here; they are left at
// their defaults of 20 m, which the graded cases must not be sensitive to.
p = ScenarioParams();
p.scenario = RURAL_MACROCELL;
p.hNodeB = 35;
p.hUe = 1.5;
p.carrierFrequencyGHz = 0.8;

probe.pathLoss("t901_rma_los",  m, p, 105.6, 100, true);       // below dBP
probe.pathLoss("t901_rma_los",  m, p, 501.1, 500, true);       // below dBP
probe.pathLoss("t901_rma_los",  m, p, 3000.19, 3000, true);    // above dBP
probe.pathLoss("t901_rma_nlos", m, p, 501.1, 500, false);
probe.pathLoss("t901_rma_nlos", m, p, 3000.19, 3000, false);

probe.expectRejected("RMa LOS d2D=11000 rejected", [&]() { m.computePathLoss(11000, 11000, true, {}); });
probe.expectRejected("RMa NLOS d2D=6000 rejected", [&]() { m.computePathLoss(6000, 6000, false, {}); });

// --- Scenarios TR 38.901 does not cover fall through to TR 36.873 -----
// SMa is evaluated by the TR 36.814 macrocell formula reached through
// TR 36.873, which the model feeds the 2D distance.
p = ScenarioParams();
p.scenario = SUBURBAN_MACROCELL;
p.hNodeB = 35;
p.hUe = 1.5;
p.hBuilding = 10;
p.wStreet = 20;
p.carrierFrequencyGHz = 2.0;

p.apply(m, this);
probe.record("t814_macro_nlos", p, { { "d", 500 } }, m.computePathLoss(501.1, 500, false, {}));

probe.summary();

%postrun-command: ../../pathloss_reference.py --grade test.out >verdict.txt

%contains: verdict.txt
graded=24 failures=0

%contains: stdout
modelchecks=5 modelfailures=0

%not-contains: verdict.txt
FAILED

%not-contains: stdout
FAILED
