#! /bin/sh
#
# usage: runtest [<testfile>...]
# without args, runs all *.test files in the current directory
#
# Requires SIMU5G_ROOT and INET_ROOT to be set (source the setenv scripts of
# both projects first), and the Simu5G and INET shared libraries to be built.
#

MODE=${MODE:-release}
if [ "$MODE" = "debug" ]; then D="_dbg"; else D=""; fi

TESTFILES=$*
if [ "x$TESTFILES" = "x" ]; then TESTFILES='*.test'; fi

if [ "x$SIMU5G_ROOT" = "x" ]; then echo "Error: SIMU5G_ROOT is not set"; exit 1; fi
if [ "x$INET_ROOT" = "x" ]; then echo "Error: INET_ROOT is not set"; exit 1; fi

if [ ! -d work ]; then mkdir work; fi

opp_test gen $OPT -v $TESTFILES || exit 1
echo

# The C++ sources of the tests' %file sections are compiled into one executable,
# linked with the Simu5G and INET libraries; tests without C++ run on it unchanged
(cd work && opp_makemake -f --deep -o moduletests -DINET_IMPORT \
     -I$SIMU5G_ROOT/src -I$INET_ROOT/src \
     -L$SIMU5G_ROOT/src -lsimu5g'$(D)' \
     -L$INET_ROOT/src -lINET'$(D)' \
 && make MODE=$MODE -j$(nproc)) || exit 1
echo

# The NED path is relative to work/<testname>/, the working directory of each test run
opp_test run -p moduletests$D $OPT -v $TESTFILES \
    -a -n .:../../lib:$SIMU5G_ROOT/src:$INET_ROOT/src || exit 1
echo
echo Results can be found in ./work
